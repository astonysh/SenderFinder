{
  "manifest_version": 3,
  "name": "Email → LinkedIn",
  "version": "0.1.0",
  "description": "在 Gmail / Outlook 网页版里显示发件人的 LinkedIn 资料（Rapportive 式）。查找由你自己的 Email-Linkedin 服务完成。",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Email → LinkedIn 设置", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["content/card.js", "content/gmail.js"], "run_at": "document_idle" },
    { "matches": ["https://outlook.live.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*"], "js": ["content/card.js", "content/outlook.js"], "run_at": "document_idle" }
  ]
}
