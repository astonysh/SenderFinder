{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "key": "",
  "name": "__MSG_ext_name__",
  "version": "0.5.2",
  "description": "__MSG_ext_description__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://api.monid.ai/*",
    "https://treg.to/*",
    "https://api.firecrawl.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_ext_name__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content/chip.js",
        "content/gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "content/chip.js",
        "content/outlook.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
