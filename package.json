{
  "name": "email-linkedin",
  "version": "0.1.0",
  "private": true,
  "description": "Rapportive-style lookup: the LinkedIn profile behind an email address, shown in Gmail/Outlook and a web app. Providers via MonID, treg and Firecrawl.",
  "type": "commonjs",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"scripts/*.test.js\"",
    "probe": "node --no-warnings=ExperimentalWarning scripts/probe-live.js",
    "lookup": "node --no-warnings=ExperimentalWarning scripts/lookup-cli.js",
    "bench": "node --no-warnings=ExperimentalWarning scripts/bench.js",
    "token": "node -e \"console.log(require('crypto').randomBytes(24).toString('base64url'))\""
  },
  "license": "UNLICENSED"
}
