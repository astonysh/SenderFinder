{
  "name": "senderfinder",
  "version": "0.5.3",
  "private": true,
  "description": "Open-source Chrome and Edge extension: the LinkedIn profile behind an email address, shown in Gmail / Outlook on the web. Bring your own provider keys; nothing leaves your browser except the calls to the providers you configured.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test \"scripts/*.test.js\"",
    "site": "node scripts/build-site.js",
    "probe": "node scripts/probe-live.js",
    "lookup": "node scripts/lookup-cli.js",
    "icons": "node scripts/make-icons.js",
    "migrate:sqlite": "node scripts/export-sqlite.js",
    "e2e": "node scripts/e2e/run.js",
    "e2e:locales": "node scripts/e2e/locales.js",
    "store:assets": "node scripts/store/shots.js",
    "zip": "node scripts/zip-extension.js",
    "zip:edge": "node scripts/zip-extension.js --edge",
    "bench": "node scripts/bench.js",
    "bump": "node scripts/bump.js",
    "site:deploy": "wrangler deploy",
    "telemetry:deploy": "cd telemetry && wrangler deploy"
  },
  "license": "AGPL-3.0-only"
}
