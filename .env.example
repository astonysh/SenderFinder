# Only for the developer scripts (npm run probe / npm run lookup). The extension does NOT read this file:
# users paste their keys into the extension's settings page, where they stay on the device.
MONID_API_KEY=            # https://app.monid.ai  → API keys
TREG_API_TOKEN=           # https://treg.to       → account → token
FIRECRAWL_API_KEY=        # https://www.firecrawl.dev/app → API keys (optional fallback)
# Budget for the CLI (the extension has its own settings)
LOOKUP_MAX_USD=0.05
DAILY_CAP_USD=2
# STEPS=signature,blitzapi,hunter,quickenrich,apollo,datalegion
SKIP_FREE_MAIL=true

# Only for scripts/metrics-report.js (project metrics snapshot). All optional; unset sources are reported as "not configured".
# GITHUB_REPO=astonysh/SenderFinder
# CWS_ITEM_ID=
# CF_ACCOUNT_ID=
# CF_API_TOKEN=            # needs D1 read (and Analytics read for CF_PAGES_PROJECT)
# CF_D1_DATABASE_ID=
# CF_PAGES_PROJECT=
# METRICS_MANUAL_JSON=docs/metrics/manual.json
