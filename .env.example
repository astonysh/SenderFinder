# ── Server ─────────────────────────────────────────────────────────────
PORT=3390
HOST=127.0.0.1
# Shared secret for the extension and the web app. Generate one: npm run token
APP_TOKEN=
# SQLite file (created on first start)
DB_PATH=./data/email-linkedin.db

# ── Provider keys (project-specific keys, do not reuse other projects') ──
MONID_API_KEY=            # https://app.monid.ai  → API keys
TREG_API_TOKEN=           # https://treg.to       → account → token
FIRECRAWL_API_KEY=        # https://www.firecrawl.dev/app → API keys (optional fallback)

# ── Budget ──────────────────────────────────────────────────────────────
# Hard cap per lookup (USD). Steps whose catalog price exceeds the remaining cap are skipped.
LOOKUP_MAX_USD=0.05
# Hard cap per calendar day (Europe/Berlin). 0 disables every paid call.
DAILY_CAP_USD=2
# Comma-separated step ids to run, in order. See GET /api/steps. Default below.
# STEPS=signature,blitzapi,hunter,quickenrich,apollo,datalegion
# Skip paid lookups for free mail providers (gmail.com, outlook.com, qq.com …) unless force=true.
SKIP_FREE_MAIL=true
